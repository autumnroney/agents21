# Copy to .env for local dev (`netlify dev`), and set the same variables in
# Netlify: Site configuration -> Environment variables (scope: Functions).
SCRAPECREATORS_API_KEY=your-key-here

# Optional. Max upstream (paid) calls per UTC day across all visitors.
# Above this, /api/search returns 503 "daily_limit". "All platforms" counts 3.
DAILY_CREDIT_CAP=500

# Optional. Log a warning when the ScrapeCreators balance drops below this.
CREDITS_ALERT_THRESHOLD=1000

# Optional. Set to true to turn search off instantly (503 "disabled"), no redeploy needed.
SEARCH_DISABLED=false
